    EDITTEXT        IDC_EDIT_DEG_LINK,40,165,65,14
    LTEXT           "コード連結規則表",IDC_STATIC,25,50,60,8
    LTEXT           "重み",IDC_STATIC,10,60,16,8
    LTEXT           "旋法,度数連結,補正",IDC_STATIC,32,60,68,8
    PUSHBUTTON      "更新／追加",IDC_BTN_UPDATE_DEG_LINK,10,185,40,15
    PUSHBUTTON      "削除",IDC_BTN_DEL_DEG_LINK,60,185,40,15
    LISTBOX         IDC_LIST_DEG_TRANS,115,70,80,95,LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_EDIT_DEG_TRANS_WEI,115,165,20,14,ES_NUMBER
    EDITTEXT        IDC_EDIT_DEG_TRANS,150,165,45,14
    PUSHBUTTON      "更新／追加",IDC_BTN_UPDATE_DEG_TRANS,115,185,40,15
    PUSHBUTTON      "削除",IDC_BTN_DEL_DEG_TRANS,155,185,40,15
    LTEXT           "コード読替え規則表",IDC_STATIC,120,50,68,8
    LTEXT           "重み",IDC_STATIC,120,60,16,8
    LTEXT           "旋法,度数読替え",IDC_STATIC,142,60,57,8
    LISTBOX         IDC_LIST_CHORD,210,70,75,110,LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "開始",IDC_BTN_START,210,185,35,15
    PUSHBUTTON      "停止",IDC_BTN_STOP,250,185,35,15
    LTEXT           "生成結果",IDC_STATIC,230,50,32,8
    LTEXT           "調",IDC_STATIC,210,60,8,8
    LTEXT           "コード",IDC_STATIC,235,60,25,8
