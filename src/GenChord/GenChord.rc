BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,20,20
    LTEXT           "GenChord Version 1.0",IDC_STATIC,40,10,119,8,SS_NOPREFIX
    LTEXT           "Copyright (C) 1999",IDC_STATIC,40,25,119,8
    DEFPUSHBUTTON   "OK",IDOK,178,7,50,14,WS_GROUP
END

IDD_GENCHORD_DIALOG DIALOGEX 0, 0, 291, 231
STYLE DS_SETFONT | DS_MODALFRAME | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "コード進行自動生成"
FONT 10, "ＭＳ 明朝", 0, 0, 0x1
BEGIN
    LISTBOX         IDC_LIST_DEVICE,5,10,190,35,LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "ＭＩＤＩデータ出力先",IDC_STATIC,5,0,75,8
    LISTBOX         IDC_LIST_DEG_LINK,5,70,100,95,LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
